# Copy to .env. Every value is optional for local development.

# Database (libSQL): a local file by default; use a libsql:// URL + token for Turso.
DATABASE_URL=file:./data/inkwell.db
DATABASE_AUTH_TOKEN=

# Email: "ethereal" (default) captures mail in a free test inbox and returns a preview link.
# Set "resend" for real delivery (free account at https://resend.com).
EMAIL_PROVIDER=ethereal
RESEND_API_KEY=re_your_api_key_here
# Without a verified domain, Resend only sends from onboarding@resend.dev to your own account address.
EMAIL_FROM_ADDRESS=onboarding@resend.dev

# Public URL of the site, used for metadata, robots.txt and the sitemap.
SITE_URL=http://localhost:3000
